@{ ViewData["Title"] = "Create a link"; }
<section class="form-page create-page">
    <div class="form-page-heading">
        <div class="eyebrow">A PRIVATE SPACE TO SHARE</div>
        <h1>Make a link.<br /><span>Keep it intentional.</span></h1>
        <p>Choose a title, add your content and set an expiry time.</p>
    </div>
    <div class="create-layout">
        <div class="create-card">
            <div class="card-topline"><span class="step-pill">NEW LINK</span><span class="private-note">↗ PRIVATE WORKSPACE</span></div>
            <h2>Link settings</h2>
            <div class="field">
                <label for="linkTitle">Link title</label>
                <input id="linkTitle" class="form-control" type="text" maxlength="80" placeholder="e.g. Project access details" />
            </div>
            <div class="field">
                <label for="message">Message <span class="optional-label">OPTIONAL</span></label>
                <textarea id="message" class="form-control message-input" rows="4" placeholder="Write or paste the information you want to share..."></textarea>
            </div>
            <div class="field">
                <label>Attach a file <span class="optional-label">OPTIONAL</span></label>
                <label class="file-dropzone" for="file">
                    <span class="file-icon">↑</span>
                    <span class="file-drop-copy"><b>Choose a file to upload</b><small>or drag and drop it here</small></span>
                    <span class="file-browse">Browse files</span>
                    <input type="file" id="file" class="file-input" />
                </label>
                <span class="field-hint" id="fileName">Small files only. File sharing will be connected in a later delivery.</span>
            </div>
            <div class="field">
                <label for="expiry">Expiry date and time</label>
                <input id="expiry" class="form-control" type="datetime-local" />
            </div>
            <label class="toggle-card">
                <span><b>One-time access</b><small>Mark this link as intended for a single view.</small></span>
                <input type="checkbox" id="oneTime" checked />
                <i></i>
            </label>
            <button type="button" class="button button-primary button-wide" id="previewButton">Create link record ↗</button>
            <p class="preview-message" id="previewMessage" role="status"></p>
            <p class="scope-note">This delivery stores link settings only. Browser encryption and real one-time access will be connected in a later stage.</p>
        </div>
        <aside class="create-aside">
            <div class="eyebrow">A SMALL REMINDER</div>
            <h3>Share with<br />intention.</h3>
            <p>Set an expiry that makes sense for the information you're sharing. Shorter access windows reduce unnecessary exposure.</p>
            <div class="aside-divider"></div>
            <ul><li><span>01</span> Choose an expiry</li><li><span>02</span> Share only with the intended person</li></ul>
            <div class="aside-orb"></div>
        </aside>
    </div>
</section>
@section Scripts {
<script>
(() => {
    const fileInput = document.getElementById('file');
    const fileName = document.getElementById('fileName');
    const zone = document.querySelector('.file-dropzone');
    fileInput?.addEventListener('change', () => {
        fileName.textContent = fileInput.files.length ? `Selected: ${fileInput.files[0].name}` : 'Small files only. File sharing will be connected in a later delivery.';
        fileName.classList.toggle('selected-file', fileInput.files.length > 0);
    });
    ['dragenter','dragover'].forEach(name => zone?.addEventListener(name, e => { e.preventDefault(); zone.classList.add('is-dragging'); }));
    ['dragleave','drop'].forEach(name => zone?.addEventListener(name, e => { e.preventDefault(); zone.classList.remove('is-dragging'); }));
    zone?.addEventListener('drop', e => {
        if (e.dataTransfer?.files?.length) {
            fileInput.files = e.dataTransfer.files;
            fileInput.dispatchEvent(new Event('change'));
        }
    });
    const expiry = document.getElementById('expiry');
    if (expiry) {
        const date = new Date(Date.now() + 24 * 60 * 60 * 1000);
        date.setMinutes(date.getMinutes() - date.getTimezoneOffset());
        expiry.value = date.toISOString().slice(0,16);
    }
    document.getElementById('previewButton')?.addEventListener('click', () => {
        const title = document.getElementById('linkTitle').value.trim();
        const message = document.getElementById('message').value.trim();
        const hasFile = fileInput.files.length > 0;
        const result = document.getElementById('previewMessage');
        if (!title) {
            result.textContent = 'Please add a title for your link.';
            result.className = 'preview-message is-warning';
            document.getElementById('linkTitle').focus();
            return;
        }
        if (!message && !hasFile) {
            result.textContent = 'Add a message or choose a file before continuing.';
            result.className = 'preview-message is-warning';
            return;
        }
        result.textContent = `Settings ready · ${hasFile ? 'File attached' : 'Text message'} · ${document.getElementById('oneTime').checked ? 'One-time access' : 'Multiple views'}. No shareable link is generated in this delivery.`;
        result.className = 'preview-message is-success';
    });
})();
</script>
}
