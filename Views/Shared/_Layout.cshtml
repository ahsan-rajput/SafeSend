<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f8f8f6" />
    <title>@ViewData["Title"] - SafeSend</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header class="site-header">
    <div class="nav-shell">
        <a class="brand" asp-controller="Home" asp-action="Index" aria-label="SafeSend home">◈ <span>SafeSend.</span></a>
        <button class="nav-toggle" type="button" aria-label="Toggle navigation" aria-expanded="false" data-nav-toggle><span></span><span></span></button>
        <nav class="main-nav" data-nav-menu>
            <a asp-controller="Home" asp-action="Index">Home</a>
            <a asp-controller="Share" asp-action="Create">Create a link</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Dashboard" asp-action="Index">My links</a>
                <span class="nav-user">@User.Identity.Name</span>
                <form asp-controller="Account" asp-action="Logout" method="post" class="nav-form"><button class="button button-quiet button-small" type="submit">Log out</button></form>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login">Log in</a>
                <a class="button button-primary button-small" asp-controller="Account" asp-action="Register">Get started ↗</a>
            }
        </nav>
    </div>
</header>
<main>@RenderBody()</main>
<footer class="site-footer"><div class="footer-inner"><a class="footer-brand" asp-controller="Home" asp-action="Index">◈ SafeSend.</a><span>Private sharing, made simple.</span><span>© @DateTime.UtcNow.Year SafeSend</span></div></footer>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
