@model IReadOnlyList<ShareLink>
@{ ViewData["Title"] = "My links"; }
<section class="dashboard-section"><div class="dashboard-heading"><div><div class="eyebrow">YOUR SPACE</div><h1>My links<span class="heading-period">.</span></h1><p>Keep track of the links associated with your account.</p></div><a class="button button-primary" asp-controller="Share" asp-action="Create">Create new link <span>↗</span></a></div><div class="dashboard-stats"><div class="stat-card"><span class="stat-label">TOTAL LINKS</span><strong>@Model.Count</strong><small>Created with your account</small></div><div class="stat-card"><span class="stat-label">ACTIVE LINKS</span><strong>@Model.Count(x => !x.IsRevoked && x.ExpiresAtUtc > DateTime.UtcNow)</strong><small>Not revoked or expired</small></div><div class="stat-card"><span class="stat-label">EXPIRED / REVOKED</span><strong>@Model.Count(x => x.IsRevoked || x.ExpiresAtUtc <= DateTime.UtcNow)</strong><small>No longer available</small></div></div><div class="table-card"><div class="table-heading"><div><h2>Recent links</h2><p>Your latest sharing activity</p></div><span class="table-count">@Model.Count records</span></div>@if (Model.Count == 0) { <div class="empty-state"><div class="empty-icon">↗</div><h3>Your links will appear here</h3><p>You haven't created any account-associated links yet.</p><a class="text-link" asp-controller="Share" asp-action="Create">Explore the create-link page →</a></div> } else { <div class="table-scroll"><table><thead><tr><th>LABEL</th><th>CREATED</th><th>EXPIRES</th><th>STATUS</th></tr></thead><tbody>@foreach (var link in Model) { var expired = link.ExpiresAtUtc <= DateTime.UtcNow; <tr><td class="table-primary-text">@link.Label</td><td>@link.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy")</td><td>@link.ExpiresAtUtc.ToLocalTime().ToString("dd MMM yyyy")</td><td><span class="status-badge @(link.IsRevoked || expired ? "status-muted" : "status-active")">@(link.IsRevoked ? "Revoked" : expired ? "Expired" : "Active")</span></td></tr> }</tbody></table></div> }</div><p class="dashboard-disclaimer">This dashboard currently displays link metadata only. Link creation, encryption and revocation are outside this delivery.</p></section>
