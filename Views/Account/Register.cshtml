@model RegisterViewModel
@{ ViewData["Title"] = "Create account"; }
<section class="auth-section"><div class="auth-aside"><div class="eyebrow eyebrow-light">A MORE PRIVATE WAY</div><h1>Keep control<br />of what you<br /><span>share.</span></h1><p>Create an account to access your personal SafeSend dashboard.</p><div class="aside-foot"><span class="aside-star">✳</span> YOUR DATA. YOUR RULES.</div></div><div class="auth-panel"><div class="auth-heading"><div class="eyebrow">GET STARTED</div><h2>Create your account</h2><p>It only takes a moment to get set up.</p></div>
<form asp-action="Register" method="post" class="auth-form" id="registerForm">
    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
    <div class="field"><label asp-for="DisplayName"></label><input asp-for="DisplayName" class="form-control" placeholder="Your name" autocomplete="name" /><span asp-validation-for="DisplayName" class="field-error"></span></div>
    <div class="field"><label asp-for="Email"></label><input asp-for="Email" class="form-control" placeholder="you@example.com" autocomplete="email" data-email-check="true" /><span asp-validation-for="Email" class="field-error"></span><span class="field-hint" id="emailFeedback" aria-live="polite"></span></div>
    <div class="field"><label asp-for="Password"></label><input asp-for="Password" class="form-control" placeholder="At least 8 characters" autocomplete="new-password" /><span asp-validation-for="Password" class="field-error"></span><span class="field-hint">Use at least 8 characters, including a number and uppercase letter.</span></div>
    <div class="field"><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" class="form-control" placeholder="Enter your password again" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="field-error"></span></div>
    <button class="button button-primary button-wide" type="submit">Create account <span>→</span></button>
</form><p class="auth-switch">Already have an account? <a asp-action="Login">Log in</a></p><div class="auth-security"><span>⌑</span> Your account details are handled securely.</div></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
