@model LoginViewModel
@{ ViewData["Title"] = "Log in"; }
<section class="auth-section"><div class="auth-aside"><div class="eyebrow eyebrow-light">WELCOME BACK</div><h1>Your privacy<br />is worth<br /><span>protecting.</span></h1><p>Sign in to keep an eye on the secure links associated with your account.</p><div class="aside-foot"><span class="aside-star">✳</span> PRIVATE BY DESIGN</div></div><div class="auth-panel"><div class="auth-heading"><div class="eyebrow">YOUR ACCOUNT</div><h2>Welcome back</h2><p>Enter your details to continue.</p></div>
<form asp-action="Login" method="post" class="auth-form">
    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
    <div class="field"><label asp-for="Email"></label><input asp-for="Email" class="form-control" placeholder="you@example.com" autocomplete="email" /><span asp-validation-for="Email" class="field-error"></span></div>
    <div class="field"><div class="label-row"><label asp-for="Password"></label></div><input asp-for="Password" class="form-control" placeholder="Enter your password" autocomplete="current-password" /><span asp-validation-for="Password" class="field-error"></span></div>
    <label class="check-row"><input asp-for="RememberMe" /><span>Keep me signed in</span></label>
    <button class="button button-primary button-wide" type="submit">Log in <span>→</span></button>
</form><p class="auth-switch">New to SafeSend? <a asp-action="Register">Create an account</a></p><div class="auth-security"><span>⌑</span> Your account is protected with secure authentication.</div></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
